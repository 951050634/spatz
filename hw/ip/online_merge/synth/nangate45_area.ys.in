#
# Versioned, unconstrained area-mapping flow for the C0/C1/C2 SMU-only scope.
# The runner renders @LIBERTY@ into a fresh external trial directory.  No
# clock, IO-delay, output-load, floorplan, routing, or power constraint is
# supplied, so the output supports only a pre-layout Liberty cell-area claim.

proc
opt
memory_collect
opt_clean
flatten
# Propagate EnginePresent and FixedMode, then extract the production FSM so
# unreachable scalar-only/full-update states are removed before arithmetic is
# bit-blasted.  Yosys does not auto-detect this state register after flattening
# because it sees no recoding benefit, so the synthesis-only flow marks the
# exact internal state wire explicitly.
opt -nosdff -nodffe
setattr -set fsm_encoding "auto" w:*state_q
fsm
opt
wreduce
techmap
opt
dfflibmap -liberty @LIBERTY@
abc -fast -liberty @LIBERTY@
clean
check -assert

tee -q -o mapped-stat.json stat -json -liberty @LIBERTY@
tee -o mapped-stat.txt stat -liberty @LIBERTY@
write_json mapped-netlist.json
write_verilog -noattr -noexpr mapped-netlist.v
